# ---------------------------------------------------------------------------
# Traffic Intelligence — environment configuration
# Copy to `.env.local` and adjust. All values are OPTIONAL: with no backend
# configured the app runs fully in deterministic simulation mode.
# ---------------------------------------------------------------------------

# Base URL of a FastAPI (or any HTTP) traffic data service.
# Expected endpoints: /health, /segments, /observations/current,
# /analytics?corridor=, /incidents (GET + POST)
NEXT_PUBLIC_TRAFFIC_API_URL=

# Base URL of the LibCity forecasting inference service.
# Expected endpoint: POST /predict
NEXT_PUBLIC_LIBCITY_MODEL_ENDPOINT=
